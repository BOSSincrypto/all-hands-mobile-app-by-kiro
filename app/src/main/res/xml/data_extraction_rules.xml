<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred. The encrypted token is useless off-device anyway
  (its key lives in this device's Keystore), and the cache holds conversation metadata
  that should not leave the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
